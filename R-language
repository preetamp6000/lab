SELECT 
    s.student_id, 
    s.first_name, 
    s.last_name, 
    COUNT(e.course_id) AS enrolled_courses_count
FROM Students s
JOIN Enrollments e ON s.student_id = e.student_id
GROUP BY s.student_id, s.first_name, s.last_name
HAVING COUNT(e.course_id) > 2;
JOIN Courses c ON e.course_id = c.course_id;





SELECT DISTINCT 
    s.first_name, 
    s.last_name
FROM Students s
JOIN Majors m ON s.major_id = m.major_id
JOIN Enrollments e ON s.student_id = e.student_id
JOIN Courses c ON e.course_id = c.course_id
WHERE m.major_name = 'Computer Science' 
  AND c.course_name = 'Math 101';
  
  
  
  
  SELECT 
    c.course_name, 
    s.first_name, 
    s.last_name, 
    e.grade
FROM Enrollments e
JOIN Courses c ON e.course_id = c.course_id
JOIN Students s ON e.student_id = s.student_id
WHERE e.grade = (
    SELECT MIN(grade) 
    FROM Enrollments 
    WHERE course_id = e.course_id
);



